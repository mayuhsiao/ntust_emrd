# 文字檔一律以 LF 儲存（跨平台一致；Windows 編輯器可正常處理 LF）
* text=auto eol=lf

# 原網站快照：逐位元組保存，不做任何換行轉換（重跑搬遷與還原原圖依賴其內容不變）
/.legacy-cache/** -text

# 圖片、影片、字型、文件等二進位檔
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.mp4 binary
*.pdf binary
*.docx binary
*.doc binary
*.odt binary
