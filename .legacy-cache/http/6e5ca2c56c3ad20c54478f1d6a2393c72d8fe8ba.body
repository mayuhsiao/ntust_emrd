<script>
$(document).ready(function() {
	// 頁籤上的鍵盤事件（保留原 Shift+Tab 邏輯，額外聚焦至上一個頁籤內容區的最後一個元素）
	$('#a9e76e71d92cfafffef010edb4af319a2_Div .nav-tabs a').keydown(function (e) {
		if (e.shiftKey && e.keyCode === 9) {
			e.preventDefault();   // 阻止瀏覽器預設焦點移動
			var $prevTabLink = $(this).parent().prev().children();
			if ($prevTabLink.length === 0) return;
			// 切換至上一個頁籤
			$prevTabLink.tab('show');
			// 等待頁籤完全顯示後，將焦點移至其內容區的「最後一個」可聚焦元素
			$prevTabLink.one('shown.bs.tab', function() {
				// 更新頁籤屬性（與 _goto 函式相同）
				$prevTabLink.prop("tabindex","0");
				$prevTabLink.attr("aria-selected","true");
				$prevTabLink.parent().siblings().children().prop("tabindex","-1");
				$prevTabLink.parent().siblings().children().removeAttr("aria-selected");
				$('#sm_a9e76e71d92cfafffef010edb4af319a2_0').prop("tabindex","0");
				// 使用 setTimeout 確保 DOM 完全更新後再聚焦（解決需按兩次問題）
				setTimeout(function() {
					var panelId = $prevTabLink.attr('href');
					if (panelId) {
						var $lastFocusable = $(panelId).find('a, button, input, select, textarea, [tabindex="0"]').filter(':visible').last();
						if ($lastFocusable.length) {
							$lastFocusable.focus();
						} else {
							// 若無任何可聚焦元素，則將焦點設於面板容器
							$(panelId).attr('tabindex', '-1').focus();
						}
					}
				}, 10);
			});
		}
	});

	// 監聽目前活動頁籤內容區內的可聚焦元素，處理 Shift+Tab 邊界反向跳回頁籤
	$(document).on('keydown', '#a9e76e71d92cfafffef010edb4af319a2_Div .tab-pane a, #a9e76e71d92cfafffef010edb4af319a2_Div .tab-pane button, #a9e76e71d92cfafffef010edb4af319a2_Div .tab-pane input, #a9e76e71d92cfafffef010edb4af319a2_Div .tab-pane select, #a9e76e71d92cfafffef010edb4af319a2_Div .tab-pane textarea, #a9e76e71d92cfafffef010edb4af319a2_Div .tab-pane [tabindex="0"]', function(e) {
		if (e.shiftKey && e.keyCode === 9) {
			var $this = $(this);
			var $panel = $this.closest('.tab-pane');
			if (!$panel.is(':visible')) return;
			// 取得目前面板內所有可聚焦元素（保持 DOM 順序）
			var $focusable = $panel.find('a, button, input, select, textarea, [tabindex="0"]').filter(':visible');
			var index = $focusable.index($this);
			// 若為目前面板的「第一個」可聚焦元素，則反向跳回目前頁籤
			if (index === 0) {
				e.preventDefault();
				$('#a9e76e71d92cfafffef010edb4af319a2_Div .nav-tabs .active a').focus();
			}
		}
	});

	// 原有的 focus 事件（不變）
	$('#a9e76e71d92cfafffef010edb4af319a2_Div .nav-tabs a').focus(function (e) {
		a9e76e71d92cfafffef010edb4af319a2_goto(this);
	});
});

function a9e76e71d92cfafffef010edb4af319a2_goto(obj){
	$(obj).tab('show');
	$(obj).prop("tabindex","0");
	$(obj).attr("aria-selected","true");
	$(obj).parent().siblings().children().prop("tabindex","-1");
	$(obj).parent().siblings().children().removeAttr("aria-selected");
	$('#sm_a9e76e71d92cfafffef010edb4af319a2_0').prop("tabindex","0");
}
</script>
