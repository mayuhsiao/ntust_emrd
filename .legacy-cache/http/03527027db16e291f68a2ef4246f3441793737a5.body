                  var currentDiv = this.closest('.mycollapse') || this.closest('.mnavbar');
                  if (currentDiv) {
                     var button= currentDiv.getElementsByClassName('navbar-toggle');
                     for (var j = 0; j < button.length; j++) {
                        button[j].click();
								$(".navbar-toggle").removeClass("open");
								setTimeout(function() { $(".navbar-toggle").focus(); }, 50);
                     }
                  }
               }
            });
         }
         var focusableElements = div[i].querySelectorAll('.nav.navbar-nav > li:last-child > a');
         if (focusableElements.length > 0) {
            focusableElements[focusableElements.length-1].addEventListener('keydown', function(event) {
               if (!event.shiftKey && event.key === 'Tab') {
 						if(this.getAttribute('aria-expanded')==='true') return;
                  $(".hdmenu .dropdown").removeClass("open");
                  var currentDiv = this.closest('.mycollapse') || this.closest('.mnavbar');
                  if (currentDiv) {
                     var button= currentDiv.getElementsByClassName('navbar-toggle');
                     for (var j = 0; j < button.length; j++) {
                        button[j].click();
                        $(".navbar-toggle").removeClass("open");
								setTimeout(function() { $(".navbar-toggle").focus(); }, 50);
                     }
                  }
               }
            });
         }
      }
   }
},1000);
}else{
	var div = document.getElementsByClassName('mycollapse');
   if(div=='undefined' || div.length==0) div = document.getElementsByClassName('mnavbar mn-collapse');
   div = div[0];
	if(typeof(div)!='undefined'){
   var focusableElements = div.querySelectorAll('a[href]');
   focusableElements[focusableElements.length-1].addEventListener('keydown', function(event) {
      if (event.key === 'Tab') {
         $(".hdmenu .dropdown").removeClass("open");
      }
   });
	}
}
}
